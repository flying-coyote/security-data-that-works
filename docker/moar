#!/usr/bin/env bash
# moar — operate the MOAR reference stack by scale preset, not by remembering --profile flags.
#
# The stack is tiered (L-I-G-E-R + agentic + detection + a SIEM foil); you run only the tiers your box and
# your question need. Scale presets bundle tiers to a RAM budget; heavy tiers start staggered (the cold-start
# OOM lesson). `verify` is the differentiator: it cross-checks that every running engine returns the same
# answer over the same Iceberg table — verify the answer, don't trust it.
#
#   ./moar up soc-10gb|soc-100gb|soc-1tb|soc-10tb    bring up an ingest-scale preset (staggered)
#   ./moar up core engine-trino detection            bring up explicit tiers
#   ./moar verify                                     cross-engine answer-equality over the lakehouse (incl. Dremio if up)
#   ./moar verify-dremio                              Dremio's answer-equality check via a Nessie source (1000/125)
#   ./moar swap-store                                 L-tier swap: identical answer on MinIO AND SeaweedFS
#   ./moar swap-catalog                               I-tier swap: identical answer via iceberg-rest, nessie AND lakekeeper
#   ./moar swap-format                                 I-tier format swap: identical answer via Iceberg AND DuckLake
#   ./moar swap-router                                 R-tier swap: identical OCSF out from Vector, Tenzir AND Fluent Bit
#   ./moar compare                                    head-to-head: open lakehouse vs the schema-on-read SIEM foil (OpenSearch)
#   ./moar hunt                                       AI tier: air-gapped agentic hunt over the lakehouse (local Ollama)
#   ./moar status | down | logs <svc>
#
# Presets — by SOC ingest scale, 10x steps. The preset picks the architecture that scale calls for; a single
# host demonstrates the architecture, not the throughput (the SDW Lab carries the measured scale sweeps). The
# old RAM-budget names (laptop/workstation/server/compare) still work as aliases. ~RAM is the host budget.
#   core                       ~2-4GB    L+I+embedded-E (minio + iceberg-rest + duckdb lab)
#   soc-10gb  (=laptop)        ~6-8GB    small SOC, ~10 GB/day: core + detection (DuckDB embedded; no JVM engines)
#   soc-100gb (=workstation)   ~16-24GB  mid SOC, ~100 GB/day: + Trino (federation) + agentic AI
#   soc-1tb   (=server)        ~32-40GB  large SOC, ~1 TB/day: + ClickHouse (real-time OLAP) + StarRocks (MPP) + route + dashboards
#   soc-10tb  (=compare)       heavy     ~10 TB/day: + the schema-on-read SIEM foil for buy-vs-build (run one SIEM at a time)
set -euo pipefail
cd "$(dirname "$0")"
DC="docker compose"

# Every preset includes store-minio: MinIO is the default object store, and the L tier is the foundation every
# other tier reads (without it iceberg-rest + lab have no lakehouse to talk to). Swap it for SeaweedFS by
# bringing up --profile store-seaweedfs with S3_INTERNAL_ENDPOINT=http://seaweedfs:8333 instead.
declare -A PRESETS=(
  [core]="store-minio core"
  # SOC ingest-scale tiers (10x steps): the components that ingest scale calls for. StarRocks (MPP) enters at
  # the large/1TB tier so it's brought up and folded into `verify` there, not just reachable as a bare profile.
  [soc-10gb]="store-minio core detection"
  [soc-100gb]="store-minio core engine-trino detection ai"
  [soc-1tb]="store-minio core engine-trino engine-clickhouse engine-starrocks route detection graph ai"
  [soc-10tb]="store-minio core engine-trino engine-clickhouse engine-starrocks route detection graph ai baselines"
  # back-compat aliases — the old RAM-budget names map to the matching ingest tier
  [laptop]="store-minio core detection"
  [workstation]="store-minio core engine-trino detection ai"
  [server]="store-minio core engine-trino engine-clickhouse engine-starrocks route detection graph ai"
  [compare]="store-minio core engine-trino engine-clickhouse engine-starrocks route detection graph ai baselines"
)
# tiers started LAST and slowly (heavy JVM/MPP cold-starts that OOM if launched simultaneously)
HEAVY="engine-clickhouse engine-starrocks engine-dremio graph baselines"

profiles_for() {  # expand preset name OR pass-through explicit tier list
  local key="$1"
  if [[ -n "${PRESETS[$key]:-}" ]]; then echo "${PRESETS[$key]}"; else shift 0; echo "$@"; fi
}

flags() { local f=""; for p in $1; do f="$f --profile $p"; done; echo "$f"; }

preflight() {  # warn if host RAM is under the preset's rough budget
  local need=$1 have; have=$(free -g 2>/dev/null | awk '/Mem:/{print $7}'); have=${have:-99}
  if (( have < need )); then
    echo "⚠  preset wants ~${need}GB free; host has ~${have}GB available. Heavy tiers may OOM (exit 137)."
    echo "   Consider a smaller preset, or bring up tiers one at a time."
  fi
}

cmd_up() {
  local key="${1:-core}"; shift || true
  local tiers; tiers=$(profiles_for "$key" "$@")
  case "$key" in
    soc-10gb|laptop) preflight 6;; soc-100gb|workstation) preflight 16;;
    soc-1tb|server) preflight 36;; soc-10tb|compare) preflight 48;;
  esac
  # light tiers first (always-needed substrate + cheap), then heavy tiers staggered
  local light="" heavy=""
  for p in $tiers; do if [[ " $HEAVY " == *" $p "* ]]; then heavy="$heavy $p"; else light="$light $p"; fi; done
  echo "→ bringing up light tiers:$light"
  $DC $(flags "$light") up -d
  for p in $heavy; do echo "→ staggered heavy tier: $p"; $DC $(flags "$light $p") up -d; sleep 12; done
  echo "✓ up. tiers: $tiers"
  echo "  run ./moar verify to cross-check engine answers."
}

cmd_down()   { $DC --profile core --profile store-minio --profile store-seaweedfs \
                  --profile index-nessie --profile index-lakekeeper \
                  --profile engine-trino --profile engine-clickhouse --profile engine-starrocks \
                  --profile engine-dremio --profile route --profile route-tenzir --profile route-fluentbit \
                  --profile detection --profile graph --profile ai --profile baselines down "$@"; }
cmd_status() { $DC ps; echo; free -h | awk 'NR==1||/Mem/'; }
cmd_logs()   { $DC logs --tail 50 "$@"; }

cmd_verify() {
  # The verify-the-answer differentiator: run an agreed query set on each RUNNING engine over the same
  # Iceberg table and assert identical answers (cross-engine answer-equality; cf. SDW Lab R3/T1.1).
  local table="ocsf.network_activity"
  echo "cross-engine answer-equality over iceberg.$table:"
  local duck trino_total ok=1
  # DuckDB (via the lab/pyiceberg) — the reference
  duck=$($DC exec -T lab python -c "
from pyiceberg.catalog.rest import RestCatalog
import os
c=RestCatalog('m', uri='http://iceberg-rest:8181', warehouse='s3://warehouse/', **{'s3.endpoint':'http://minio:9000','s3.access-key-id':os.environ['AWS_ACCESS_KEY_ID'],'s3.secret-access-key':os.environ['AWS_SECRET_ACCESS_KEY'],'s3.path-style-access':'true','s3.region':'us-east-1'})
t=c.load_table('$table').scan().to_arrow()
import pyarrow.compute as pc
print(t.num_rows, t.filter(pc.equal(t['dst_port'],3389)).num_rows)
" 2>/dev/null) || { echo "  duckdb/lab: not available"; return 1; }
  echo "  duckdb (lab)     total,rdp = $duck"
  # Trino, if running
  if $DC ps --status running --services 2>/dev/null | grep -qx trino; then
    local tt tr
    tt=$($DC exec -T trino trino --execute "SELECT count(*) FROM iceberg.$table" 2>/dev/null | tr -d '"')
    tr=$($DC exec -T trino trino --execute "SELECT count(*) FROM iceberg.$table WHERE dst_port=3389" 2>/dev/null | tr -d '"')
    echo "  trino            total,rdp = $tt $tr"
    [[ "$duck" == "$tt $tr" ]] || { echo "  ✗ DIVERGENCE: trino != duckdb"; ok=0; }
  fi
  # ClickHouse, if running — reads the SAME Iceberg table via the icebergS3 table function (snapshot-correct).
  if $DC ps --status running --services 2>/dev/null | grep -qx clickhouse; then
    local ch
    ch=$($DC exec -T clickhouse clickhouse local --query \
      "SELECT toString(count())||' '||toString(countIf(dst_port=3389)) FROM icebergS3('http://minio:9000/warehouse/ocsf/network_activity','moar','moar-dev-secret')" 2>/dev/null | tr -d '"')
    echo "  clickhouse       total,rdp = $ch"
    [[ "$duck" == "$ch" ]] || { echo "  ✗ DIVERGENCE: clickhouse != duckdb"; ok=0; }
  fi
  # StarRocks, if running — reads the SAME table via an Iceberg REST external catalog (created idempotently here,
  # since StarRocks has no boot-time catalog file). The fourth independent reader codebase in the gate.
  if $DC ps --status running --services 2>/dev/null | grep -qx starrocks; then
    local sr
    $DC exec -T starrocks mysql -P 9030 -h 127.0.0.1 -u root -e "
      CREATE EXTERNAL CATALOG IF NOT EXISTS iceberg PROPERTIES (
        'type'='iceberg','iceberg.catalog.type'='rest',
        'iceberg.catalog.uri'='http://iceberg-rest:8181','iceberg.catalog.warehouse'='warehouse',
        'aws.s3.endpoint'='http://minio:9000','aws.s3.enable_path_style_access'='true',
        'aws.s3.enable_ssl'='false','aws.s3.access_key'='moar','aws.s3.secret_key'='moar-dev-secret',
        'aws.s3.region'='us-east-1');" >/dev/null 2>&1 || true
    sr=$($DC exec -T starrocks mysql -N -B -P 9030 -h 127.0.0.1 -u root -e \
      "SELECT count(*), count_if(dst_port=3389) FROM iceberg.$table;" 2>/dev/null | tr '\t' ' ')
    echo "  starrocks        total,rdp = $sr"
    [[ "$duck" == "$sr" ]] || { echo "  ✗ DIVERGENCE: starrocks != duckdb"; ok=0; }
  fi
  # Dremio, if running — the fifth engine, reading the Nessie-written copy (OSS lacks the iceberg-rest source).
  # Same logical OCSF data, so it joins the gate; self-contained via config/dremio/setup-dremio.sh (REST setup).
  if $DC ps --status running --services 2>/dev/null | grep -qx dremio; then
    local dr
    dr=$(bash config/dremio/setup-dremio.sh 2>/dev/null | grep -oE 'total,rdp = [0-9]+ [0-9]+' | grep -oE '[0-9]+ [0-9]+$')
    echo "  dremio (nessie)  total,rdp = ${dr:-unavailable}"
    [[ "$duck" == "$dr" ]] || { echo "  ✗ DIVERGENCE: dremio != duckdb"; ok=0; }
  fi
  [[ $ok == 1 ]] && echo "  ✓ all running engines agree" || { echo "  ✗ engines disagree — investigate"; return 1; }
}

cmd_verify_dremio() {
  # Dremio's standalone answer-equality check (federation engine, via a Nessie source). OSS has no Iceberg REST
  # catalog source, so Dremio reads the Nessie-written copy of ocsf.network_activity — the same logical OCSF
  # data the iceberg-rest gate reads, independently committed through a second catalog. Confirmed 1000/125.
  echo "Dremio answer-equality check (via Nessie source):"
  if ! $DC ps --status running --services 2>/dev/null | grep -qx dremio; then
    echo "  dremio not running — bring it up: ./moar up core index-nessie engine-dremio"; return 1
  fi
  bash config/dremio/setup-dremio.sh
}

cmd_swap_catalog() {
  # Prove the I-tier (catalog) is swappable: write+read the SAME OCSF table through THREE catalog
  # implementations over the SAME object store, and assert an identical answer. The open table format means one
  # read contract; the catalog behind it is replaceable, and the swap is only trustworthy if the answer doesn't
  # move. Three independent codebases implement the same Iceberg REST spec — iceberg-rest (Java reference
  # fixture), Nessie (Java/Quarkus, git-style branching), Lakekeeper (Rust, Postgres-backed) — so agreement
  # across all three is a strong portability signal, not a single-implementation coincidence.
  echo "I-tier catalog swap check (iceberg-rest vs nessie vs lakekeeper), same MinIO store:"
  $DC --profile store-minio --profile index-nessie --profile index-lakekeeper up -d >/dev/null 2>&1 || true
  echo "  waiting for nessie + lakekeeper (lakekeeper migrates, serves, bootstraps, creates the warehouse) ..."
  for i in $(seq 1 20); do curl -fsS http://localhost:19121/iceberg/v1/config >/dev/null 2>&1 && break; sleep 3; done
  # lakekeeper is ready once its Iceberg REST config resolves the bootstrapped warehouse (init one-shot done)
  for i in $(seq 1 40); do curl -fsS "http://localhost:8182/catalog/v1/config?warehouse=warehouse" >/dev/null 2>&1 && break; sleep 3; done
  local a b c
  a=$($DC exec -T lab python /lab/smoke_core.py 2>/dev/null | grep -oE 'dst_port=3389 -> [0-9]+' | grep -oE '[0-9]+$')
  b=$($DC exec -T -e ICEBERG_REST_URI=http://nessie:19120/iceberg/ -e WAREHOUSE=warehouse lab \
        python /lab/smoke_core.py 2>/dev/null | grep -oE 'dst_port=3389 -> [0-9]+' | grep -oE '[0-9]+$')
  c=$($DC exec -T -e ICEBERG_REST_URI=http://lakekeeper:8181/catalog -e WAREHOUSE=warehouse lab \
        python /lab/smoke_core.py 2>/dev/null | grep -oE 'dst_port=3389 -> [0-9]+' | grep -oE '[0-9]+$')
  echo "  iceberg-rest: rdp=${a:-?}   nessie: rdp=${b:-?}   lakekeeper: rdp=${c:-?}"
  if [[ -n "$a" && "$a" == "$b" && "$a" == "$c" ]]; then
    echo "  ✓ catalog swap clean — identical answer across three independent catalog implementations"
  else echo "  ✗ catalog swap DIVERGENCE (iceberg-rest=$a nessie=$b lakekeeper=$c)"; return 1; fi
}

cmd_swap_format() {
  # Prove I-tier *format* portability (distinct from the catalog swap above): the SAME logical OCSF batch,
  # written through a DIFFERENT table format (DuckLake — SQL-database catalog + Parquet on the same MinIO),
  # returns the identical answer as the Iceberg path. DuckLake is not an Iceberg REST catalog, so this isn't a
  # drop-in catalog swap; it's "the data and the answer outlive the format." Runs in the existing lab container.
  echo "I-tier format swap check (Iceberg vs DuckLake), same OCSF batch, same MinIO store:"
  local ice dl
  ice=$($DC exec -T lab python /lab/smoke_core.py 2>/dev/null | grep -oE 'dst_port=3389 -> [0-9]+' | grep -oE '[0-9]+$')
  dl=$($DC exec -T lab python /lab/swap_format_ducklake.py 2>/dev/null | grep -oE 'dst_port=3389 -> [0-9]+' | grep -oE '[0-9]+$')
  echo "  iceberg: rdp=${ice:-?}   ducklake: rdp=${dl:-?}"
  if [[ -n "$ice" && "$ice" == "$dl" ]]; then
    echo "  ✓ format swap clean — identical answer across Iceberg and DuckLake on the same object store"
  else echo "  ✗ format swap DIVERGENCE (iceberg=$ice ducklake=$dl)"; return 1; fi
}

cmd_swap_store() {
  # Prove the L-tier (object store) is swappable: write+read the SAME OCSF batch on BOTH MinIO and SeaweedFS
  # and assert an identical answer. Both speak S3, so the lakehouse is indifferent to which is underneath — the
  # store-footprint choice (SeaweedFS ~10× lighter) doesn't move the answer. Same shape as swap-catalog /
  # swap-format / swap-router, completing the swap-command set across all of L-I-R.
  echo "L-tier store swap check (MinIO vs SeaweedFS), same OCSF batch:"
  $DC --profile store-minio --profile store-seaweedfs up -d >/dev/null 2>&1 || true
  echo "  waiting for SeaweedFS + its warehouse-bucket init ..."
  for i in $(seq 1 20); do [ "$(curl -s -o /dev/null -w '%{http_code}' http://localhost:8333/ 2>/dev/null)" != "000" ] && break; sleep 3; done
  sleep 6   # let seaweedfs-init create the warehouse bucket
  local out m s
  out=$($DC exec -T lab python /lab/swap_store.py 2>/dev/null)
  echo "$out" | grep -E "store (minio|seaweedfs)"
  m=$(echo "$out" | sed -n 's/.*store minio .*-> \([0-9]\{1,\}\).*/\1/p')
  s=$(echo "$out" | sed -n 's/.*store seaweedfs .*-> \([0-9]\{1,\}\).*/\1/p')
  if [[ -n "$m" && "$m" == "$s" ]]; then
    echo "  ✓ store swap clean — identical answer (rdp=$m) on MinIO and SeaweedFS"
  else echo "  ✗ store swap DIVERGENCE (minio=$m seaweedfs=$s)"; return 1; fi
}

cmd_swap_router() {
  # Prove the R-tier (route/normalization) is swappable across THREE independent codebases: Vector/VRL (Rust),
  # Tenzir/TQL (C++, security-native), and Fluent Bit/Lua (C, CNCF) all turn the SAME raw Okta event into the
  # SAME OCSF Authentication record. verify-the-answer for the normalization stage (cf. swap-catalog for the
  # catalog, swap-format for the table format, the MinIO/SeaweedFS bake-off for the store).
  echo "R-tier route swap check (Vector vs Tenzir vs Fluent Bit), same raw Okta sample -> OCSF Authentication:"
  local tz fb vok=0 tzok=0 fbok=0
  # Tenzir + Fluent Bit emit OCSF JSON to stdout; assert both events carry the OCSF contract (key order is not
  # guaranteed across routers, so match on field/value presence, not byte-identical lines).
  tz=$($DC run --rm -T route-tenzir 2>/dev/null) || true
  if echo "$tz" | grep -q '"class_uid":3002.*"activity_id":1.*jdoe@acme.example.*10\.10\.1\.21' \
     && echo "$tz" | grep -q '"activity_id":2.*svc@acme.example.*203\.0\.113\.7'; then tzok=1; fi
  fb=$($DC run --rm -T route-fluentbit 2>/dev/null) || true
  # Fluent Bit serializes keys in a different order, so check each event's line for the required fields
  # independently rather than in one ordered regex (the order-independent form swap-router's comment calls for).
  local fbj fbs
  fbj=$(echo "$fb" | grep 'jdoe@acme.example'); fbs=$(echo "$fb" | grep 'svc@acme.example')
  if echo "$fbj" | grep -q '"class_uid":3002' && echo "$fbj" | grep -q '"activity_id":1' \
     && echo "$fbj" | grep -q '"src_ip":"10.10.1.21"' \
     && echo "$fbs" | grep -q '"activity_id":2' && echo "$fbs" | grep -q '"src_ip":"203.0.113.7"'; then fbok=1; fi
  # Vector has a native test harness for its transform
  $DC run --rm -T route test /etc/vector/vector.yaml >/dev/null 2>&1 && vok=1
  echo "  vector  (vector test):    $([ $vok  = 1 ] && echo 'PASS — okta_auth_to_ocsf' || echo 'FAIL')"
  echo "  tenzir  (okta-ocsf.tql):  $([ $tzok = 1 ] && echo 'PASS — class_uid 3002, activity 1/2, user, src_ip' || echo 'FAIL')"
  echo "  fluentbit (ocsf.lua):     $([ $fbok = 1 ] && echo 'PASS — class_uid 3002, activity 1/2, user, src_ip' || echo 'FAIL')"
  if [[ $vok = 1 && $tzok = 1 && $fbok = 1 ]]; then
    echo "  ✓ router swap clean — all three routers emit the identical OCSF Authentication contract"
  else echo "  ✗ router swap problem (vector=$vok tenzir=$tzok fluentbit=$fbok)"; return 1; fi
}

cmd_compare() {
  # The fair-broker head-to-head the baselines tier exists for: load the SAME OCSF corpus into the open
  # lakehouse (Parquet on MinIO, queried by DuckDB) AND the schema-on-read SIEM foil (OpenSearch — the open
  # representative; Splunk is reference-only per EULA), run the SAME queries on each, and report answer-equality
  # + storage footprint + the needle-vs-scan latency shape. Don't replace the incumbent blind — benchmark it.
  # Corpus size via FOIL_N (default 200000). lab/foil_compare.py carries the methodology caveats.
  echo "Head-to-head: open lakehouse vs schema-on-read SIEM foil (OpenSearch), same OCSF data, same queries:"
  $DC --profile store-minio --profile core --profile baselines up -d >/dev/null 2>&1 || true
  echo "  waiting for OpenSearch ..."
  for i in $(seq 1 40); do [ "$(curl -s -o /dev/null -w '%{http_code}' http://localhost:9211/_cluster/health 2>/dev/null)" = "200" ] && break; sleep 3; done
  $DC exec -T -e FOIL_N="${FOIL_N:-200000}" lab python /lab/foil_compare.py
}

cmd_hunt() {
  # AI tier: an air-gapped, practitioner-owned agentic hunt over the lakehouse with a LOCAL model (Ollama).
  # Reaching the host's Ollama: the compose default is host.docker.internal, which is right when Ollama runs on
  # the Docker host. Under Docker Desktop on WSL2 with Ollama in a SEPARATE WSL distro, host.docker.internal
  # resolves to an unreachable IPv6 and gateway.docker.internal doesn't forward into the distro — so reach
  # Ollama directly at the WSL host's eth0 IP, recomputed each run (it's dynamic across WSL restarts). Override
  # with OLLAMA_URL / OLLAMA_MODEL. Cleaner permanent alternative: WSL2 'networkingMode=mirrored' in .wslconfig.
  local host_ip url
  host_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  url="${OLLAMA_URL:-http://${host_ip}:11434}"
  local model="${OLLAMA_MODEL:-gemma4:e4b}"
  echo "AI tier — air-gapped agentic hunt over the lakehouse (local model):"
  echo "  ollama: $url   model: $model"
  $DC --profile store-minio --profile core --profile ai up -d ai >/dev/null 2>&1 || true
  if ! $DC exec -T -e OLLAMA_URL="$url" ai python -c "import urllib.request;urllib.request.urlopen('$url/api/tags',timeout=8)" 2>/dev/null; then
    echo "  ✗ can't reach Ollama at $url from the ai container."
    echo "    Is 'ollama serve' bound to 0.0.0.0 (OLLAMA_HOST=0.0.0.0:11434)? Override with OLLAMA_URL=..."
    return 1
  fi
  $DC exec -T -e OLLAMA_URL="$url" -e OLLAMA_MODEL="$model" ai python /ai/agent.py
}

case "${1:-}" in
  up) shift; cmd_up "$@";;
  down) shift; cmd_down "$@";;
  status) cmd_status;;
  verify) cmd_verify;;
  verify-dremio) cmd_verify_dremio;;
  swap-store) cmd_swap_store;;
  swap-catalog) cmd_swap_catalog;;
  swap-format) cmd_swap_format;;
  swap-router) cmd_swap_router;;
  compare) cmd_compare;;
  hunt) cmd_hunt;;
  logs) shift; cmd_logs "$@";;
  *) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
esac
